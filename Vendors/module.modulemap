module BZip2 [system] {
  header "bzlib_shim.h"
  link "bz2"
  export *
}

module LZMA [system] {
  header "lzma_shim.h"
  link "lzma"
  export *
}

module Curses [system] {
  header "curses_shim.h"
  export *
  link "ncurses"
}
