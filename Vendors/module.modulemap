module BZip2 [system] {
  header "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/bzlib.h"
  link "bz2"
  export *
}

module LZMA [system] {
  header "/opt/homebrew/include/lzma.h"
  link "lzma"
  export *
}
